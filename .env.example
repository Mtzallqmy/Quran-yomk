# ==============================================================================
# Quran Yutla (قرآن يتلى) — Environment Variables Matrix
# ==============================================================================

# --- FIREBASE SERVER-SIDE CREDENTIALS (SUPABASE SECRETS / BACKEND ONLY) ---
# NEVER expose these values to Flutter, Web Client, APK, or Git repository!
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- FIREBASE CLIENT-SIDE IDENTIFIERS (PUBLIC / APP ONLY) ---
FIREBASE_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FCM_VAPID_KEY=

# --- PLATFORM CONFIGURATION ---
ANDROID_PACKAGE_NAME=app.quranyutla
IOS_BUNDLE_ID=app.quranyutla

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=

# --- APPLICATION RUNTIME ---
APP_ENV=development
API_BASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
