# Quran Yutla Mobile Environment Configuration
# Client-safe credentials (Never commit real secrets or service_role keys!)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Live Icecast Radio Stream Base URL
RADIO_STREAM_BASE_URL=https://stream.quranyutla.app

# Optional Elysia BFF URL (Defaults to Supabase Edge if empty)
ELYSIA_BFF_URL=

# App identifiers
APP_IDENTIFIER=app.quranyutla
APP_ENV=development
