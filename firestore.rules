rules_version = '2';

// =============================================================================
// Quran Yutla (قرآن يتلى) — Firestore Security Rules
// =============================================================================
// NOTE: The backend for this project is Firebase (Firebase Auth + Firestore).
//   1. Firebase Authentication (Email/Password user identity)
//   2. Firestore database (User profiles, bookmarks, favorites, and preferences)
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile & preferences — owner-only access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Nested bookmarks and listening history
      match /bookmarks/{bookmarkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public catalog (read-only for authenticated users, managed via Supabase)
    match /stations/{stationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
