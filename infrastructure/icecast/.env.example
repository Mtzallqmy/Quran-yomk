# Development placeholders only. Generate unique values; never commit the real .env file.
TARTEEL_ICECAST_SOURCE_PASSWORD=replace-with-random-development-secret
TARTEEL_ICECAST_RELAY_PASSWORD=replace-with-another-random-development-secret
TARTEEL_ICECAST_ADMIN_USER=admin
TARTEEL_ICECAST_ADMIN_PASSWORD=replace-with-random-development-admin-secret
TARTEEL_ICECAST_HOSTNAME=localhost
TARTEEL_ICECAST_PORT=8000
TARTEEL_ICECAST_BASEDIR=/usr/share/icecast2
TARTEEL_ICECAST_LOGDIR=/var/log/icecast2
