# Audio Worker Environment Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-worker-service-role-key

# Audio normalization target (EBU R128 standard)
TARGET_LUFS=-16.0
MAX_TRUE_PEAK_DBTP=-1.0
LOUDNESS_RANGE_LU=7.0

# Worker concurrency
MAX_CONCURRENT_JOBS=2
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
