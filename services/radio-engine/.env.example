# Radio Engine Environment Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-radio-engine-service-role-key

# Icecast & Liquidsoap Control
LIQUIDSOAP_TELNET_HOST=localhost
LIQUIDSOAP_TELNET_PORT=1234
