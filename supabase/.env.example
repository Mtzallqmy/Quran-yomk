# Supabase Local & Production Environment Configuration (NO REAL SECRETS)
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Client-safe keys
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only secrets (NEVER expose to mobile or browser clients!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
JWT_SECRET=your-secure-jwt-secret-placeholder
